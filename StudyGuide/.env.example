# Copy to .env.local for local development. Never commit the filled-in file.
# MongoDB username/password accounts. No email or OTP is needed by the Account page.
# Set AUTH_PROVIDER=mongodb to enable this backend.
# Leave AUTH_PROVIDER=supabase only when retaining the existing account backend.
AUTH_PROVIDER=mongodb
MONGODB_URI=
MONGODB_DATABASE=kr7tech
# Private random secret of at least 32 characters. Never send it to the browser.
AUTH_OTP_SECRET=
# Optional stable HMAC key for API rate-limit identifiers; falls back to AUTH_OTP_SECRET.
RATE_LIMIT_SECRET=
RESEND_API_KEY=
# Legacy email backend only; not used by normal username/password forms.
AUTH_EMAIL_FROM=
# Legacy verified-email owner allowlist; normal username signup cannot claim these identities.
MONGODB_ADMIN_EMAILS=
# Optional localhost-only administrator testing. Always false on hosted deployments.
LOCAL_ADMIN_LOGIN_ENABLED=false

# Legacy Supabase settings below are not required in MongoDB mode.
# Use the project base URL, not the /rest/v1/ Data API endpoint.
SUPABASE_URL=https://zhzcmykfzeooadngrnyc.supabase.co
PUBLIC_APP_URL=http://127.0.0.1:10000

# Public publishable key or legacy anon key, from Supabase Settings > API Keys.
SUPABASE_ANON_KEY=

# Legacy server-only service_role JWT, from Settings > API Keys.
# Never expose this privileged key in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Production-only PIN access: 8-128 characters; signing secret: at least 32.
# Leave both blank to disable PIN access. Never deploy the short localhost PIN.
PRO_ACCESS_PIN=
PRO_ACCESS_SECRET=

# Optional administrator account UUIDs, separated by commas.
ADMIN_USER_IDS=

# Optional community forms. Apply supabase/community.sql first.
# Real public support email; forms stay closed until this is configured.
SUPPORT_EMAIL=
# Private random secret of at least 32 characters for hashed rate-limit keys.
COMMUNITY_FORM_SECRET=

# Optional integrations: configure only the providers you intend to use.
# Enable production purchases only after reviewing policies, publishing SUPPORT_EMAIL,
# configuring live provider webhooks, and testing verified payment -> membership.
SALES_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.paypal.com
PAYPAL_PRO_USD=
PAYPAL_GO_USD=
PAYPAL_L1_USD=
PAYPAL_L2_USD=
PAYPAL_L3_USD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_INTERVIEW_ALLOW_ANONYMOUS=false
# Optional hosted Judge0 endpoint. For a loopback-only local service, use npm run setup:local-judge0.
JUDGE0_API_URL=
JUDGE0_API_TOKEN=

# Configure Google Client ID/Secret inside Supabase's Google provider, not here.
# Google authorized redirect URI for this project:
# https://zhzcmykfzeooadngrnyc.supabase.co/auth/v1/callback
